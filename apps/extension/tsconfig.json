{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "lib": [
            "DOM",
            "ES2022"
        ],
        "types": [
            "chrome"
        ],
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "build.mjs"
    ]
}